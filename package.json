{
  "name": "abstractplay-bot-aiai",
  "version": "1.0.0-beta",
  "description": "Abstract Play AiAi registered bot (webhook + Java worker)",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run check-ci-deps && npm run typecheck",
    "test": "vitest run",
    "check-ci-deps": "node scripts/check-ci-deps.mjs",
    "sync-deps": "ap-install-deps --stage dev",
    "sync-deps:prod": "ap-install-deps --stage prod",
    "fetch-aiai-engine": "node scripts/fetch-aiai-engine.mjs",
    "layer:pack": "node scripts/layer-pack.mjs",
    "layer:publish": "node scripts/layer-publish.mjs",
    "jre:layer:pack": "node scripts/jre-layer-pack.mjs",
    "ensure:jre-layer": "node scripts/ensure-jre-layer.mjs",
    "start:local": "node scripts/with-stage-env.mjs dev tsx src/localServer.ts",
    "start:local:dev": "node scripts/with-stage-env.mjs dev tsx src/localServer.ts",
    "start:local:prod": "node scripts/with-stage-env.mjs prod tsx src/localServer.ts",
    "package:sls": "node scripts/with-stage-env.mjs dev npx serverless package --stage dev",
    "package:sls:prod": "node scripts/with-stage-env.mjs prod npx serverless package --stage prod",
    "ci:install": "npm ci",
    "ci:install:prod": "npm ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbstractPlay/bot-aiai.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@abstractplay/gameslib": "1.0.0-ci-40116441762.0",
    "@abstractplay/renderer": "1.0.0-ci-40109814064.0",
    "@aws-sdk/client-lambda": "3.1090.0",
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/client-sqs": "3.1090.0"
  },
  "devDependencies": {
    "@abstractplay/ap-deps-tools": "^1.1.2",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.39.0",
    "serverless": "4.42.0",
    "serverless-esbuild": "^1.57.0",
    "tsx": "^4.8.1",
    "typescript": "^5.0.4",
    "vitest": "^3.2.4"
  }
}
