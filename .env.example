# OAuth (from create_bot + serverless stage config)
BOT_CLIENT_ID=
BOT_CLIENT_SECRET=
BOT_TOKEN_URL=
BOT_OAUTH_SCOPE=
BOT_QUERY_URL=

# Optional: override AP webhook signing key (defaults to play.abstractplay.com key)
# AP_BOT_PUBLIC_KEY=

# Worker queue (set by Serverless in AWS)
# MOVE_QUEUE_URL=

# Local AiAi CLI (defaults to ./engine when aiai.jar is present; Lambda uses /opt/java/lib/aiaicli)
# AIAI_CLI_ROOT=
# AIAI_JAVA=java

# Set to 1 to compute moves without POSTing botQuery (tests / dry run)
# BOT_SUBMIT_DISABLED=1
