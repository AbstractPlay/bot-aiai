# Stage-specific secrets and bot OAuth live in gitignored files:
#
#   cp .env.dev.example  .env.dev   # local dev bot + deploy --stage dev
#   cp .env.prod.example .env.prod  # prod bot (local package/deploy only)
#
# CI uses GitHub Actions secrets instead of these files.
# URLs per stage match `custom.stageConfig` in serverless.yml.
