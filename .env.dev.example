# Copy to `.env.dev` (gitignored). Dev bot from `create_bot` on the dev site.
# (CI uses GitHub secrets AIAI_BOT_ID / AIAI_BOT_SECRET instead of these names.)
BOT_CLIENT_ID=
BOT_CLIENT_SECRET=
BOT_TOKEN_URL=https://abstract-play-bots-dev.auth.us-east-1.amazoncognito.com/oauth2/token
BOT_OAUTH_SCOPE=default-m2m-resource-server-dev/communicate
BOT_QUERY_URL=https://alyhqu85me.execute-api.us-east-1.amazonaws.com/dev/botQuery

# Optional: override AP webhook signing key (defaults to play.abstractplay.com key)
# AP_BOT_PUBLIC_KEY=

# Worker queue (set by Serverless in AWS; optional for local worker experiments)
# MOVE_QUEUE_URL=

# Optional: S3 bucket for layer zip staging (default: AP private ops bucket)
# AIAI_LAYER_PUBLISH_BUCKET=

# Local AiAi CLI (defaults to ./engine when aiai.jar is present)
# AIAI_CLI_ROOT=
# AIAI_JAVA=java

# Set to 1 to compute moves without POSTing botQuery
# BOT_SUBMIT_DISABLED=1
